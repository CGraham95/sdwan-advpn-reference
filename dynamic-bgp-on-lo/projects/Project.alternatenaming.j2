{#                            Project Template                                #}
{# -------------------------------------------------------------------------- #}
{# Anonymized example demonstrating compact deterministic VPN tunnel naming   #}
{# using <hub_name>_<ul_id><network_id>.                                      #}
{# -------------------------------------------------------------------------- #}
{# Design flavor: "Dynamic BGP on Loopback"                                   #}
{# -------------------------------------------------------------------------- #}

{# Optional Settings #}
{
{% set cert_auth = false %}
{% set psk = vpnpass %}

{% set intrareg_hub2hub = false %}
{% set intrareg_advpn = true %}
{% set multireg = true %}
{% set multireg_advpn = true %}
{% set spoke2hub_advpn = false %}
{% set hub_hc_server = '10.200.99.1' %}

{% set advpn2 = true %}
{% set dynamic_bgp = false %}

{% set strict_peering = false %}

{% set short_community_as = '65000' %}
{% set hub_strict_syn = true %}
{% set lan_summary = '10.0.0.0/8' %}
}

{# Mandatory Global Definitions #}
{
{% set lo_summary = '10.255.255.0/24' %}
}

{# -------------------------------------------------------------------------- #}
{# Regions                                                                    #}
{# -------------------------------------------------------------------------- #}

{% set regions = {
    'REGION1': {
      'as': '64600',
      'hubs': [ 'HUB1', 'HUB2', 'HUB3', 'HUB4', 'HUB5', 'HUB6' ]
    }
  }
%}

{# -------------------------------------------------------------------------- #}
{# Device Profiles                                                            #}
{#                                                                            #}
{# ul_id identifies the local WAN underlay independently of ol_type.           #}
{#                                                                            #}
{# Example naming:                                                            #}
{#   HUB1_111 = HUB1 / underlay 1 / network-id 11                             #}
{#   HUB1_211 = HUB1 / underlay 2 / network-id 11                             #}
{# -------------------------------------------------------------------------- #}

{
{% set profiles = {
    'SingleISP': {
      'interfaces': [
        {
